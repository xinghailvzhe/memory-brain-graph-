+def _mbg_ws_gate_file():
+    return os.path.join(ROOT, "workspace-gate.json")
+
+
+def _mbg_current_workspace():
+    try:
+        db = (DBS[0] if ("DBS" in globals() and DBS) else DB)
+        return os.path.dirname(os.path.dirname(os.path.abspath(db)))
+    except Exception:
+        return ""
+
+
+def _mbg_gate_read():
+    """启用名单：优先 workspace-gate.json；没有就默认=记忆库所在工作区。"""
+    try:
+        with open(_mbg_ws_gate_file(), "r", encoding="utf-8") as fh:
+            data = json.load(fh) or {}
+        ws = [str(x) for x in (data.get("workspaces") or []) if str(x).strip()]
+        if ws:
+            return ws
+    except Exception:
+        pass
+    cur = _mbg_current_workspace()
+    return [cur] if cur else []
+
+
+def _mbg_gate_write(ws):
+    path = _mbg_ws_gate_file()
+    tmp = path + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as fh:
+        json.dump({"workspaces": ws, "updatedAt": int(time.time() * 1000)},
+                  fh, ensure_ascii=False, indent=1)
+    os.replace(tmp, path)
+
+
+def _mbg_all_workspaces():
+    out = _recent_workspaces(limit=500)
+    cur = _mbg_current_workspace()
+    if cur and cur not in out and os.path.isdir(cur):
+        out.insert(0, cur)
+    return out
+
+
+_GATE_LOCK = threading.Lock()
+_GATE_SUBS = []
+
+
+def _gate_payload():
+    try:
+        return json.dumps({"workspaces": _mbg_gate_read()}, ensure_ascii=False)
+    except Exception:
+        return '{"workspaces": []}'
+
+
+def _gate_broadcast():
+    payload = _gate_payload()
+    with _GATE_LOCK:
+        subs = list(_GATE_SUBS)
+    for q in subs:
+        try:
+            q.put_nowait(payload)
+        except Exception:
+            pass
 
 
